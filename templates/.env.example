# Copy into each actual app's environment. These values are not live credentials.
# Next.js public configuration:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_KEY

# Spring environment / secrets; never prefix with NEXT_PUBLIC_:
DATABASE_URL=jdbc:postgresql://localhost:5432/doezip
DATABASE_USERNAME=doezip
DATABASE_PASSWORD=doezip_local_only
GEMINI_API_KEY=REPLACE_WITH_SERVER_SECRET
AI_CHAT_MODEL=gemini-2.5-flash
AI_EVALUATION_MODEL=gemini-2.5-flash
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_JWKS_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_EXPECTED_AUDIENCE=authenticated
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Spring Boot does not automatically import a file called .env.
# Configure the IDE/run environment or a reviewed local loading mechanism.
# Production credentials and example values must never be mixed.
