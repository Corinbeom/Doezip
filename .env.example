# 로컬 전용 예시. 실제 .env는 커밋하지 않는다.
POSTGRES_DB=doezip
DATABASE_USERNAME=doezip
DATABASE_PASSWORD=doezip_local_only
DB_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/doezip
API_PORT=8080
WEB_PORT=3000
CORS_ALLOWED_ORIGIN=http://localhost:3000
# 제품 API base는 기존 계약의 /api/v1. health는 별도 운영 경로.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# 공개 페이지에 표시할 실제 운영자 개인정보 문의 이메일로 교체한다.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=operator@example.com
# Gemini 결제 연결 전에는 unpaid로 유지한다. 공개 사용자 입력은 paid 전환 후 받는 것을 권장한다.
NEXT_PUBLIC_GEMINI_DATA_TIER=unpaid

# 조회용 가상 과제 seed는 로컬 프로필에만 적용한다. 운영 설정으로 사용하지 않는다.
SPRING_PROFILES_ACTIVE=local

# Google 로그인 설정 전에는 비활성. docs/AUTH_SETUP.md 참고.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTH_ENABLED=false
AUTH_ISSUER=
AUTH_JWK_SET_URI=
AUTH_AUDIENCE=authenticated
AUTH_PROVIDER_ID=doezip-supabase
# 서버 전용. Supabase project URL 뒤에 /auth/v1을 붙이고, secret key(legacy service_role도 가능)를 설정한다.
# 브라우저 변수나 로그에 절대 노출하지 않는다. 회원 탈퇴 기능에만 사용한다.
SUPABASE_AUTH_URL=
SUPABASE_SECRET_KEY=

# Server-only AI evaluation. Enable only after saving your own Gemini key.
AI_EVALUATION_ENABLED=false
GEMINI_API_KEY=
AI_EVALUATION_MODEL=gemini-3.5-flash-lite
AI_EVALUATION_DAILY_CALL_LIMIT=10
AI_EVALUATION_GLOBAL_DAILY_CALL_LIMIT=50

# Learning chat: separate opt-in; server-only key shared with Gemini evaluation.
AI_CHAT_ENABLED=false
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_CHAT_DAILY_CALL_LIMIT=20
AI_CHAT_GLOBAL_DAILY_CALL_LIMIT=100

# F08a: code proposals only; public tests run in the browser
AI_CODING_ENABLED=false
AI_CODING_MODEL=gemini-3.5-flash-lite
